APP_NAME=MangaWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mangaweb_completo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file

# Registrate una vez; después cambiá a false para cerrar nuevos registros.
ALLOW_REGISTRATION=true

# Suwayomi corre aparte; no expongas su puerto a Internet.
SUWAYOMI_URL=http://127.0.0.1:4567
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=

VITE_APP_NAME=MangaWeb

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1100
DOWNLOAD_MAX_PAGES=400
DOWNLOAD_MAX_IMAGE_BYTES=12582912
ALLOW_EXTENSION_MANAGEMENT=false
SESSION_SECURE_COOKIE=false
