{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "jsx": "preserve", "isolatedModules": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "types": ["vite/client"], "noEmit": true
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "vite.config.ts"]
}
